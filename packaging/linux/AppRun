#!/bin/sh
set -eu

appdir=${APPDIR:-"$(dirname "$(readlink -f "$0")")"}

if [ "${1:-}" = "--mcp-stdio" ]; then
    shift
    exec "$appdir/usr/bin/devhub-mcp" "$@"
fi

if [ "${1:-}" = "--mcp-http" ]; then
    shift
    exec "$appdir/usr/bin/devhub-mcp" --http "$@"
fi

if [ "${1:-}" = "--mcp-scan" ]; then
    shift
    exec "$appdir/usr/bin/devhub-mcp" --scan "$@"
fi

exec "$appdir/usr/bin/devhub-gpui" "$@"
